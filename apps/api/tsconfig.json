{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@nova-town/shared": ["../../packages/shared/src/index.ts"],
      "@prisma/client": ["../../packages/database/node_modules/@prisma/client"]
    }
  },
  "include": ["src/**/*"]
}
