{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@nova-town/game-engine": ["../../packages/game-engine/src"],
      "@nova-town/game-core": ["../../packages/game-core/src"],
      "@nova-town/economy": ["../../packages/economy/src"],
      "@nova-town/shared": ["../../packages/shared/src"]
    }
  },
  "include": ["src/**/*"]
}
