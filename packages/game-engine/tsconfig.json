{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@nova-town/shared": ["../shared/src"],
      "@nova-town/economy": ["../economy/src"],
      "@nova-town/game-core": ["../game-core/src"],
      "@nova-town/game-engine": ["./src"]
    }
  },
  "include": ["src/**/*"]
}
