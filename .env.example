# --- Database (PostgreSQL) ---
# Required. The API fails closed (503) on protected endpoints when the DB is unavailable.
# PowerShell: $env:DATABASE_URL="postgresql://novatown:CHANGE_ME@localhost:5432/novatown"
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/novatown?schema=public"

# --- API ---
PORT=4000
NODE_ENV="development"
# Comma-separated list of allowed CORS origins in production (keep tight, not "*")
CORS_ORIGIN="*"

# --- Auth (required) ---
# Telegram bot token (BotFather). NEVER commit the real value; used server-side to
# verify WebApp initData HMAC. Without it, /auth/telegram returns 503 (fail closed).
TELEGRAM_BOT_TOKEN="REPLACE_WITH_BOT_TOKEN"
# HMAC key for signed session tokens (createSessionToken/verifySessionToken).
# Use a random 32+ byte value. Without it, protected endpoints return 503 (fail closed).
JWT_SECRET="REPLACE_WITH_RANDOM_SECRET"
# Session lifetime in days (default 7)
SESSION_TTL_DAYS=7
